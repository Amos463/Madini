<?xml version="1.0" encoding="utf-8"?>
<!-- Zuia Google auto-backup na device-to-device transfer: ufunguo wa Keystore
     hauhamishiki, hivyo database iliyorejeshwa ingekuwa haisomeki. Tumia
     backup ya .mdbak ya ndani ya app. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root"/>
        <exclude domain="file"/>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
        <exclude domain="external"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root"/>
        <exclude domain="file"/>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
        <exclude domain="external"/>
    </device-transfer>
</data-extraction-rules>
